    {
      "kind": "response",
      "model": "claude-sonnet-4.5",
      "message": {
        "role": "assistant",
        "parts": [
          {
            "type": "text",
            "text": "4"
          }
        ]
      },
      "finish": "end_turn"
    },
    {
      "kind": "check",
      "line": 14,
      "message": "sendAndWait resolves with an assistant.message event",
      "pass": true
    },
    {
      "kind": "check",
      "line": 15,
      "message": "the reply carries the model's text (got \"4\")",
      "pass": true
    },
    {
      "kind": "check",
      "line": 26,
      "message": "events arrive in order: user.message → assistant.turn_start → assistant.message → assistant.turn_end → session.idle",
      "pass": true
    },
    {
      "kind": "check",
      "line": 30,
      "message": "the session has an id",
      "pass": true
    },
    {
      "kind": "check",
      "line": 33,
      "message": "one model request reached the mock (got 1)",
      "pass": true
    },
    {
      "kind": "check",
      "line": 34,
      "message": "by default the runtime offers its built-in tools, bash included",
      "pass": true
