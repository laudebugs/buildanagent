{
  "format": 1,
  "example": "01-hello-session",
  "file": "verify/copilot-sdk/examples/01-hello-session.ts",
  "harness": "verify/copilot-sdk",
  "pin": "@github/copilot-sdk@1.0.31",
  "mock": "@github/copilot-sdk@1.0.31",
  "events": [
    {
      "kind": "request",
      "model": "claude-sonnet-4.5",
