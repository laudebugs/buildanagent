{
  "format": 1,
  "example": "01-hello-agent",
  "file": "verify/langchain/examples/01-hello-agent.ts",
  "harness": "verify/langchain",
  "pin": "langchain@1.6.1",
  "mock": "@langchain/core@1.3.4",
  "events": [
    {
      "kind": "request",
      "line": 10,
      "model": "model-1",
      "repeated": 0,
      "messages": [
        {
          "role": "system",
          "parts": [
            {
              "type": "text",
              "text": "You are terse."
            }
          ]
        },
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Say hello."
            }
          ]
        }
      ],
      "tools": []
    },
    {
      "kind": "response",
      "line": 10,
      "model": "model-1",
      "message": {
        "role": "assistant",
        "parts": [
          {
            "type": "text",
            "text": "Hello from the fake model."
          }
        ]
      },
      "finish": "stop"
    },
    {
      "kind": "check",
      "line": 12,
      "message": "the last message is the model's answer",
      "pass": true
    },
    {
      "kind": "check",
      "line": 13,
      "message": "messages hold the user turn and the answer",
      "pass": true
    },
    {
      "kind": "check",
      "line": 14,
      "message": "one model call without tools",
      "pass": true
    },
    {
      "kind": "check",
      "line": 16,
      "message": "systemPrompt arrives as the system message",
      "pass": true
    }
  ]
