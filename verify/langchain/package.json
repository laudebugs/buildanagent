{
  "name": "@buildanagent/verify-langchain",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "scripts": {
    "fetch-docs": "node scripts/fetch-docs.mjs",
    "extract": "node scripts/extract-examples.mjs",
    "typecheck:docs": "node scripts/typecheck-examples.mjs",
    "run:docs": "node scripts/run-examples.mjs",
    "factcheck": "node scripts/factcheck-api.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/run-examples.mjs examples",
    "verify": "pnpm run extract && pnpm run typecheck:docs && pnpm run triage:docs && pnpm run run:docs && pnpm run factcheck && pnpm test",
    "triage:docs": "node scripts/ahead-of-release.mjs && node scripts/mismatch-causes.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.5",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "@langchain/openai": "1.8.4",
    "langchain": "1.6.6",
    "zod": "4.6.7"
  }
}
