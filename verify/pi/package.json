{
  "name": "@buildanagent/verify-pi",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "scripts": {
    "fetch-docs": "node scripts/fetch-docs.mjs",
    "extract": "node scripts/extract-examples.mjs",
    "typecheck:docs": "node scripts/typecheck-examples.mjs",
    "run:docs": "node scripts/run-examples.mjs",
    "factcheck": "node scripts/factcheck-api.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/run-examples.mjs examples",
    "verify": "pnpm run extract && pnpm run typecheck:docs && pnpm run run:docs && pnpm run factcheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "typebox": "1.4.7"
  }
}
