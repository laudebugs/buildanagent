{
  "name": "buildanagent",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "description": "Research and verification harnesses for building an AI agent and our own agent harness.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm -r --if-present verify",
    "fact-check-logs": "node scripts/ci/fact-check-log.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.0"
  }
}
