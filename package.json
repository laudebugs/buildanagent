{
  "name": "buildanagent",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "description": "Research and verification harnesses for building an AI agent and our own agent harness.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm -r --if-present verify",
    "fact-check-logs": "node scripts/ci/fact-check-log.mjs",
    "check:deps": "depcruise packages --config .dependency-cruiser.json",
    "check:duplicates": "jscpd --config .jscpd.json",
    "check:unused": "knip --no-progress",
    "check:ids": "node scripts/ci/todo-ids.mjs",
    "check:links": "node scripts/ci/markdown-links.mjs",
    "check:api-docs": "pnpm --filter @buildanagent/docs check:api-docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.0"
  }
}
