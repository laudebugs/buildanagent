---
import Annotations from "./Annotations.astro";
import { captionParts, listingCodeHtml } from "./listing-html.js";
import type { ListingLine, ListingNote } from "./types.js";

// A listing: its number, the file path, the line range and the pinned package, then the code on a panel, with
// highlighted lines, annotation markers and the notes they point to.
interface Props {
  readonly id: string;
  readonly number: string;
  readonly path: string;
  readonly pin: string;
  readonly lines: readonly ListingLine[];
  readonly notes?: readonly ListingNote[];
  /** Whether the live run leaves this listing's file out, so only mock models verify it. */
  readonly mockOnly?: boolean;
}

const { id, number, path, pin, lines, notes = [], mockOnly = false } = Astro.props;
const noteNumber = new Map(notes.map((note, index) => [note.id, index + 1]));
---

<figure class="listing panel" id={id} aria-labelledby={`${id}-caption`}>
  <figcaption class="listing__caption" id={`${id}-caption`}>
    <span class="listing__number">Listing {number}</span>
    {captionParts(path, lines, pin, mockOnly).map((part) => <span class={part.className}>{part.text}</span>)}
  </figcaption>
  <Fragment set:html={listingCodeHtml(id, number, lines, noteNumber)} />
  <Annotations listingId={id} notes={notes} />
</figure>
