---
// The theme toggle: a sun in the dark theme and a moon in the light one, each the mode a press switches to.
// public/scripts/theme.js sets its accessible name, "Switch to dark theme" or "Switch to light theme", and its
// data-mode, which the stylesheet reads to pick the icon. Without JavaScript it stays hidden and the page follows
// prefers-color-scheme.
---

<button type="button" class="control theme-toggle" data-theme-toggle aria-label="Switch theme" hidden>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>
