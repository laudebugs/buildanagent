---
import { replayHtml } from "./replay-html.js";
import type { ReplayEvent } from "./types.js";

// A recorded run beside a listing. Without JavaScript every event shows in order; src/scripts/steps.ts reveals them
// one by one with back, next, restart and play. A chapter's `::listing{… replay}` renders the same markup from
// replay-html.ts.
interface Props {
  readonly id: string;
  readonly title: string;
  readonly source: string;
  readonly events: readonly ReplayEvent[];
  /** The id of the listing whose lines the replay highlights. */
  readonly listing?: string;
}

const { id, title, source, events, listing } = Astro.props;
---

<Fragment set:html={replayHtml({ id, title, source, events, ...(listing === undefined ? {} : { listing }) })} />

<script>
  import "../scripts/steps.ts";
</script>
