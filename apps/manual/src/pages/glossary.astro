---
import { citeHref } from "../book/citations.js";
import { getBook } from "../book/load.js";
import ChapterHead from "../components/ChapterHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const book = getBook();

// Every glossary entry, in alphabetical order. Each anchor is the id a chapter's term links point at.
const entries = [...book.glossary.values()].sort((a, b) => a.term.localeCompare(b.term, "en"));
---

<BaseLayout title="Glossary" description="The terms the book uses, each with one meaning across every chapter.">
  <div class="page page--single">
    <ChapterHead
      title="Glossary"
      lede="Each term means one thing in every chapter, and a chapter links a term here once in each paragraph that uses it."
    />
    <div class="article">
      <dl>
        {
          entries.map((entry) => (
            <>
              <dt id={entry.id}>{entry.kind === "abbr" ? <abbr>{entry.term}</abbr> : entry.term}</dt>
              <dd>
                {entry.kind === "abbr" && <>{entry.expansion}. </>}
                {entry.definition}{" "}
                {entry.sources.map((id, k) => (
                  <>
                    {k > 0 && ", "}
                    <a href={citeHref(id)}>{book.sources.get(id)?.title}</a>
                  </>
                ))}
              </dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</BaseLayout>
