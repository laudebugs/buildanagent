---
import { getBook } from "../book/load.js";
import ChapterHead from "../components/ChapterHead.astro";
import Contents from "../components/Contents.astro";
import { contentsParts } from "../components/contents-parts.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const book = getBook();

// The contents come from the outline, not from the chapter files, so a planned chapter shows in its place, as plain
// text until its file exists (BK5).
const parts = contentsParts(book);
---

<BaseLayout title="Build an agent" description="A textbook on building an AI agent.">
  <div class="page page--single">
    <ChapterHead title="Build an agent" lede="A textbook on building an AI agent." />
    {/* public/scripts/reading.js fills in and shows the link when this browser holds a reader's place in a chapter.
        The paragraph keeps its height while the link is hidden, so the contents never move when it appears. */}
    <p class="resume" data-resume>
      <a class="resume__link" data-resume-link hidden>
        <span class="resume__action label">Resume reading <span data-resume-chapter></span></span><span class="visually-hidden">: </span>
        <span class="resume__where" data-resume-where></span>
      </a>
    </p>
    <nav aria-label="Contents" class="article">
      <Contents parts={parts} />
    </nav>
  </div>
</BaseLayout>
