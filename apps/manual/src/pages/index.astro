---
import { getCollection } from "astro:content";
import ChapterHead from "../components/ChapterHead.astro";
import Contents from "../components/Contents.astro";
import { contentsParts } from "../components/contents-parts.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const parts = contentsParts(await getCollection("chapters"));
---

<BaseLayout title="Build an agent" description="A textbook on building an AI agent.">
  <div class="page">
    <ChapterHead title="Build an agent" lede="A textbook on building an AI agent." />
    <nav aria-label="Contents" class="article">
      <Contents parts={parts} />
    </nav>
  </div>
</BaseLayout>
