---
import { getCollection } from "astro:content";
import ChapterHead from "../components/ChapterHead.astro";
import Contents from "../components/Contents.astro";
import type { ContentsPart } from "../components/types.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const chapters = await getCollection("chapters");
const parts: ContentsPart[] = [
  {
    title: "Chapters",
    chapters: chapters.map((chapter, index) => ({
      number: index + 1,
      title: chapter.data.title,
      href: `/${chapter.id}/`,
    })),
  },
];
---

<BaseLayout title="Build an agent" description="A textbook on building an AI agent.">
  <div class="page">
    <ChapterHead title="Build an agent" lede="A textbook on building an AI agent." />
    <nav aria-label="Contents" class="article">
      <Contents parts={parts} />
    </nav>
  </div>
</BaseLayout>
