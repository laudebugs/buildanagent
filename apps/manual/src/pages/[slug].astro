---
import { getCollection, render } from "astro:content";
import { getBook } from "../book/load.js";
import { contentsParts, neighbours } from "../components/contents-parts.js";
import ChapterLayout from "../layouts/ChapterLayout.astro";

const book = getBook();

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((chapter) => ({ params: { slug: chapter.id }, props: { chapter } }));
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);
// "On this page" lists the chapter's sections; a tab's heading (its id starts "lst-") names a listing, not a section.
// The number and the neighbouring chapters come from the outline, never from the collection's file order (BK5).
const number = book.bySlug.get(chapter.id)?.number;
const { previous, next } = neighbours(book, chapter.id);
const listed = (book.index.written.get(chapter.id)?.blocks ?? []).flatMap((block) =>
  block.kind === "listing" && block.source !== undefined ? [block.source.path] : [],
);
const hasFileListing = listed.length > 0;
const hasComparedListing = listed.some((path) => book.live.compared.has(path));
---

<ChapterLayout
  title={chapter.data.title}
  description={chapter.data.summary}
  label={`Chapter ${number}`}
  lede={chapter.data.summary}
  headings={headings.filter((heading) => heading.depth === 2 && !heading.slug.startsWith("lst-"))}
  parts={contentsParts(book)}
  current={`/${chapter.id}/`}
  previous={previous}
  next={next}
  sources={chapter.data.sources}
  hasFileListing={hasFileListing}
  hasComparedListing={hasComparedListing}
>
  <Content />
</ChapterLayout>
