---
import ChapterHead from "../components/ChapterHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { book } from "../markdown/options.js";

// Every register entry, in the register's order. Each anchor is the id chapters cite with [@id].
const sources = [...book.sources.values()];
---

<BaseLayout title="Sources" description="Every source the book cites, and the fact-check log that verified it.">
  <div class="page">
    <ChapterHead title="Sources" />
    <div class="article">
      <p>
        Every source below was checked in one of the repository's fact-check logs, named under each entry. Versions and
        pages change, so each entry says when it was read.
      </p>
      <ul>
        {
          sources.map((source) => (
            <li id={source.id}>
              <a href={source.url}>{source.title}</a>, {source.publisher} ({source.kind}
              {source.version ? `, ${source.version}` : ""}), as of {source.asOf}. Checked in <code>{source.verifiedIn}</code>.
              {source.secondary && (
                <p class="secondary-note">
                  That check rests on a search summary or a secondary write-up, not on the source itself.
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
