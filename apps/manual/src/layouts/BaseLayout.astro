---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/anatomy.css";
import type { PageProps } from "./page-props.js";

type Props = PageProps & {
  /** Keeps the page out of search engines, as the component gallery is. */
  readonly noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Blocking on purpose: it applies a stored theme before the first paint. -->
    <script is:inline src="/scripts/theme.js"></script>
    <!-- A module, so it runs once the page is parsed: it records the reader's place and shows the resume link. -->
    <script is:inline type="module" src="/scripts/reading.js"></script>
    <link rel="preload" href="/fonts/literata/literata-roman.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif/instrument-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the text</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
