---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/header.css";
import "../styles/figures.css";
import "../styles/anatomy.css";
import tokens from "../../../../docs/design/book-tokens.json";
import { offlineHosts } from "../offline/hosts.js";
import type { PageProps } from "./page-props.js";

type Props = PageProps & {
  /** Keeps the page out of search engines, as the component gallery is. */
  readonly noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
// The browser's toolbar takes the page colour of the reader's system theme, as the installed app's manifest does.
const pageColor = { light: tokens.color.light.values.background, dark: tokens.color.dark.values.background };
// Only these hosts register the offline worker; public/scripts/offline.js reads them (src/offline/hosts.ts).
const hosts = offlineHosts(Astro.site, process.env.MANUAL_OFFLINE_TEST_HOST).join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={pageColor.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={pageColor.dark} />
    <meta name="manual-offline-hosts" content={hosts} />
    <!-- scripts/offline-build.mjs writes the build id here, so the offline worker knows this page's build. -->
    <meta name="manual-build" content="__MANUAL_BUILD__" />
    <!-- Blocking on purpose: it applies a stored theme before the first paint. -->
    <script is:inline src="/scripts/theme.js"></script>
    <!-- A module, so it runs once the page is parsed: it records the reader's place and shows the resume link. -->
    <script is:inline type="module" src="/scripts/reading.js"></script>
    <!-- A module too: it registers the offline worker on the book's own host and shows the update notice. -->
    <script is:inline type="module" src="/scripts/offline.js"></script>
    <!-- The footer's "Save the manual for offline reading" control; it talks to the worker offline.js registers. -->
    <script is:inline type="module" src="/scripts/save-offline.js"></script>
    <link rel="preload" href="/fonts/literata/literata-roman.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif/instrument-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the text</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
