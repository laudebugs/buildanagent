{
  "name": "@buildanagent/manual",
  "version": "0.0.0",
  "private": true,
  "description": "The buildanagent textbook on building an agent, published at manual.buildanagent.fyi.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "exports": {
    "./design/tokens": "./src/design/tokens.ts",
    "./design/contrast": "./src/design/contrast.ts",
    "./design/woff2": "./src/design/woff2.ts",
    "./figures/svgkit": "./figures/lib/svgkit.ts",
    "./styles/figures.css": "./src/styles/figures.css"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/offline-build.mjs dist",
    "icons": "node scripts/generate-icons.mjs",
    "check:offline": "node scripts/offline-browser-check.mjs",
    "check:header": "node scripts/header-check.mjs",
    "check:save-offline": "node scripts/save-offline-check.mjs",
    "offline:verify": "node scripts/offline-verify-deployed.mjs",
    "check:book": "tsx scripts/check-book.ts",
    "audit:papers": "tsx scripts/audit-papers.ts",
    "check:touch-fields": "node scripts/touch-fields-check.mjs",
    "check:note-sheet": "node scripts/note-sheet-check.mjs",
    "check:note-editor": "node scripts/note-editor-flow-check.mjs",
    "check:note-popover": "node scripts/note-popover-check.mjs",
    "book:switch-report": "tsx scripts/switch-report.ts",
    "figures:build": "tsx scripts/build-figures.ts figures test/fixtures/book/figures test/fixtures/site/figures",
    "figures:audit": "tsx scripts/audit-figures.ts figures test/fixtures/book/figures test/fixtures/site/figures",
    "registers:format": "tsx scripts/format-registers.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "anatomy:css": "tsx scripts/generate-anatomy-css.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && node --test scripts/*.test.mjs && tsx scripts/switch-report.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "astro": "7.4.11",
    "esbuild": "0.28.2",
    "pagefind": "1.6.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "typescript-api": "npm:typescript@6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "unist-util-visit-parents": "6.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@buildanagent/gateway": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "axe-core": "4.14.1",
    "happy-dom": "21.0.4",
    "mdast-util-to-hast": "13.2.1",
    "typescript": "7.0.2",
    "vfile": "6.0.3",
    "wrangler": "4.160.1"
  }
}
