{
  "name": "@buildanagent/manual",
  "version": "0.0.0",
  "private": true,
  "description": "The buildanagent textbook on building an agent, published at manual.buildanagent.fyi.",
  "license": "Apache-2.0 OR MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "check:book": "tsx scripts/check-book.ts",
    "book:switch-report": "tsx scripts/switch-report.ts",
    "tokens": "tsx scripts/generate-tokens.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && tsx scripts/switch-report.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "astro": "7.4.11",
    "pagefind": "1.6.0",
    "remark-directive": "4.0.0",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@buildanagent/gateway": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "happy-dom": "21.0.4",
    "mdast-util-to-hast": "13.2.1",
    "typescript": "7.0.2",
    "vfile": "6.0.3"
  }
}
