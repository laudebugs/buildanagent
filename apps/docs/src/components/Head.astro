---
// Starlight's head, plus a preload for the two faces nearly every line of a page uses, the body and display romans,
// as the book does, so the first paint does not wait for them. A test checks that these are the token file's roman
// faces and that public/fonts/ serves them.
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default {...Astro.props}><slot /></Default>
<link rel="preload" href="/fonts/literata/literata-roman.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/instrument-serif/instrument-serif-regular.woff2" as="font" type="font/woff2" crossorigin />
