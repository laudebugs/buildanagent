---
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { siteLinks } from "../chrome.js";
---

<nav class="site-links" aria-label="buildanagent sites">
  {
    siteLinks.map((link) => (
      <a href={link.href} aria-current={link.current ? "true" : undefined}>
        {link.label}
      </a>
    ))
  }
</nav>
<Default {...Astro.props} />

<style>
  .site-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--sl-text-sm);
  }

  .site-links a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    padding-block: 0.5rem;
  }

  .site-links a:hover {
    color: var(--sl-color-white);
  }

  /* The current site and the others differ in colour by less than 3:1, so colour alone cannot tell them apart (WCAG
     1.4.1). The others keep their underline at rest, and the current site, in plain text, has none. */
  .site-links a[aria-current] {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  @media (max-width: 49.99rem) {
    .site-links {
      flex-wrap: wrap;
      padding-block: 0.5rem;
    }

    .site-links a {
      padding-block: 0.75rem;
    }
  }
</style>
