---
// The header's title: the mark from the logo, then the wordmark "Build An Agent docs". The link keeps Starlight's own
// address for the docs home. On a narrow screen only the mark shows, and the wordmark stays in the page for screen
// readers, so the link always has a name.
// The version tag sits beside the link, not inside it, so the link's name stays "Build An Agent docs".
import { SDK_VERSION } from "../version/version.js";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title-row sl-flex">
  <a href={siteTitleHref} class="site-title sl-flex">
    <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <rect x="7" y="7" width="50" height="50" rx="11" fill="none" stroke="currentColor" stroke-width="5"></rect>
      <path
        d="M21 23L34 32L21 41"
        fill="none"
        stroke="currentColor"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path d="M38 43H48" fill="none" stroke="var(--color-accent)" stroke-width="5" stroke-linecap="round"></path>
    </svg>
    <span class="wordmark" translate="no"><span class="name">Build An Agent</span> <span class="kind">docs</span></span>
  </a>
  <span class="version" translate="no"><span class="label">Version </span>{SDK_VERSION}</span>
</div>

<style>
  .site-title-row {
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-title {
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .mark {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    overflow: hidden;
  }

  /* The display face sets small for its size, so the name is larger than the body text beside it. */
  .name {
    font-size: 1.5rem;
    line-height: 1;
  }

  /* "docs" is the lighter, mono half of the wordmark. */
  .kind {
    font-family: var(--font-code);
    font-size: var(--size-label);
    color: var(--sl-color-gray-3);
  }

  .site-title:hover .name {
    color: var(--sl-color-white);
  }

  /* The version is the SDK's, read when the site is built; the six packages share it. */
  .version {
    font-family: var(--font-code);
    font-size: var(--size-label);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
    border: 1px solid var(--color-rule);
    border-radius: 0.25rem;
    padding: 0.0625rem 0.375rem;
  }

  /* The word "Version" names the number for a screen reader; sighted readers see the number alone. */
  .label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (forced-colors: active) {
    .version {
      border-color: CanvasText;
    }
  }

  /* Hidden to the eye but not to a screen reader, so the mark alone still has a name. The version goes the same way,
     because the mark and the tag together would crowd the header. */
  @media (max-width: 29.99rem) {
    .version,
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
