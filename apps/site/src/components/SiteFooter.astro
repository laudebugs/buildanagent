---
import { repository } from "../landing/chrome.js";
// The footer lines of the landing copy, then the licence line every page carries.
import { copy } from "../landing/copy.js";
---

<footer class="site-footer">
  <p>{copy.footer.map((line) => <span>{line}</span>)}</p>
  <p>
    The code is licensed <a href={`${repository}/blob/main/LICENSE`}>Apache-2.0 OR MIT</a>. The content on this site and
    in the docs is licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
  </p>
</footer>
