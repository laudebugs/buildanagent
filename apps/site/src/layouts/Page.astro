---
// The frame of a package page: the shared header and footer around the page's title and Markdown.
import Base from "./Base.astro";

interface Props {
  frontmatter: { title: string; description: string };
}
const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description} bodyClass="page">
  <main>
    <h1>{frontmatter.title}</h1>
    <slot />
  </main>
</Base>
