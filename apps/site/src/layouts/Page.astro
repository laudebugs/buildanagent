---
// The frame of every page: a header with the docs and repository links, the page's Markdown, and the licence footer.
interface Props {
  frontmatter: { title: string; description: string };
}
const { frontmatter } = Astro.props;
const DOCS = "https://docs.buildanagent.fyi";
const REPOSITORY = "https://github.com/laudebugs/buildanagent";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title}</title>
    <meta name="description" content={frontmatter.description} />
  </head>
  <body>
    <header>
      <a class="brand" href="/">buildanagent</a>
      <nav aria-label="Main">
        <a href="/packages/gateway/">Gateway</a>
        <a href="/packages/sdk/">SDK</a>
        <a href={DOCS}>Docs</a>
        <a href={REPOSITORY}>GitHub</a>
      </nav>
    </header>
    <main>
      <h1>{frontmatter.title}</h1>
      <slot />
    </main>
    <footer>
      <p>
        The code is licensed <a href={`${REPOSITORY}/blob/main/LICENSE`}>Apache-2.0 OR MIT</a>. The content on this
        site and in the docs is licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #55575c;
    --link: #0b5cad;
    --rule: #d8dadf;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --fg: #ececec;
      --muted: #a6a9b0;
      --link: #7ab7ff;
      --rule: #2e3138;
    }
  }
  body {
    margin: 0 auto;
    max-width: 44rem;
    padding: 0 1rem;
    background: var(--bg);
    color: var(--fg);
    font: 1.0625rem/1.6 system-ui, sans-serif;
  }
  a {
    color: var(--link);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .brand {
    color: var(--fg);
    font-weight: 700;
    text-decoration: none;
  }
  h1 {
    margin: 2rem 0 1rem;
    font-size: 2rem;
    line-height: 1.2;
  }
  h2 {
    margin: 2rem 0 0.5rem;
    font-size: 1.25rem;
  }
  pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 0.375rem;
    font-size: 0.9375rem;
  }
  code {
    font-family: ui-monospace, monospace;
  }
  footer {
    margin: 3rem 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
