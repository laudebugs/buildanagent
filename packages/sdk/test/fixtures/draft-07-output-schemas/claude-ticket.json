  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["title", "priority", "labels"],
    "additionalProperties": false
  },
  "valid": [
    {
      "title": "Login crashes on Safari",
      "priority": "high",
      "labels": ["bug"]
    }
  ],
  "invalid": [
    {
      "value": {
        "title": "Login crashes",
        "priority": "urgent",
        "labels": []
      },
      "paths": ["/priority"]
    }
  ]
