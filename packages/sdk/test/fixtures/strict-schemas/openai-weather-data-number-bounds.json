{
  "name": "openai-weather-data-number-bounds",
  "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
  "section": "Supported properties, number restrictions: weather_data",
  "checkedOn": "2026-11-19",
  "note": "The docs type unit as string or null, but its enum lists no null, so a null unit fails both validators, as JSON Schema says it must.",
  "schema": {
    "type": "object",
    "properties": {
      "location": {
        "type": "string",
        "description": "The location to get the weather for"
      },
      "unit": {
        "type": ["string", "null"],
        "description": "The unit to return the temperature in",
        "enum": ["F", "C"]
      },
      "value": {
        "type": "number",
        "description": "The actual temperature value in the location",
        "minimum": -130,
        "maximum": 130
      }
    },
    "additionalProperties": false,
    "required": ["location", "unit", "value"]
  },
  "valid": [
    {
      "location": "Oslo",
      "unit": "C",
      "value": -5.5
    }
  ],
  "invalid": [
    {
      "value": {
        "location": "Oslo",
        "unit": "C",
        "value": 131
      },
      "paths": ["/value"]
    },
    {
      "value": {
        "location": "Oslo",
        "unit": null,
        "value": 1
      },
      "paths": ["/unit"]
    }
  ]
}
