{
  "name": "@buildanagent/sdk",
  "version": "0.1.0-alpha.29",
  "description": "The buildanagent SDK: the agent loop, tools, hooks, signed pauses and budgets over the gateway.",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/buildanagent.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/laudebugs/buildanagent/tree/main/packages/sdk#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "llms.txt",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "source": "./src/otel/index.ts",
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./otel": {
        "types": "./dist/otel/index.d.ts",
        "default": "./dist/otel/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/copy-licenses.mjs",
    "prepublishOnly": "node ../../scripts/refuse-local-publish.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buildanagent/gateway": "workspace:*",
    "@earendil-works/pi-schema": "1.5.2",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@buildanagent/agent-safety": "workspace:*",
    "@cfworker/json-schema": "4.1.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace": "2.12.1",
    "miniflare": "5.20261103.0-beta",
    "zod": "4.6.7"
  }
}
