{
  "name": "@buildanagent/agent-safety",
  "version": "0.0.0",
  "private": true,
  "description": "Safety core for buildanagent agents: typed write outcomes the model can read, a canonical input hash, signed approvals and model calls on the user's own key.",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/buildanagent.git",
    "directory": "packages/agent-safety"
  },
  "homepage": "https://github.com/laudebugs/buildanagent/tree/main/packages/agent-safety#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "source": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./byok": {
      "source": "./src/byok/index.ts",
      "types": "./dist/byok/index.d.ts",
      "default": "./dist/byok/index.js"
    },
    "./agents": {
      "source": "./src/agents/index.ts",
      "types": "./dist/agents/index.d.ts",
      "default": "./dist/agents/index.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ai": {
        "types": "./dist/ai/index.d.ts",
        "default": "./dist/ai/index.js"
      },
      "./byok": {
        "types": "./dist/byok/index.d.ts",
        "default": "./dist/byok/index.js"
      },
      "./agents": {
        "types": "./dist/agents/index.d.ts",
        "default": "./dist/agents/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/copy-licenses.mjs",
    "prepublishOnly": "node ../../scripts/refuse-local-publish.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/workerd/tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/provider-utils": "5.0.74",
    "ai": "7.0.162"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/provider-utils": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/provider-utils": "5.0.74",
    "@buildanagent/gateway": "workspace:*",
    "@cloudflare/ai-chat": "0.12.2",
    "@cloudflare/workers-types": "5.20261103.1",
    "agents": "0.33.0",
    "ai": "7.0.162",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "zod": "4.6.7"
  }
}
