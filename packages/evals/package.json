{
  "name": "@buildanagent/evals",
  "version": "0.0.0",
  "private": true,
  "description": "The buildanagent evals: reports, mini-swe-agent trajectories and an offline replay suite that judge the harness.",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/buildanagent.git",
    "directory": "packages/evals"
  },
  "homepage": "https://github.com/laudebugs/buildanagent/tree/main/packages/evals#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/copy-licenses.mjs",
    "prepublishOnly": "node ../../scripts/refuse-local-publish.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@buildanagent/gateway": "workspace:*"
  }
}
