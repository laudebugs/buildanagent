{
  "name": "@buildanagent/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The buildanagent command line: runs the harness in a terminal.",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/buildanagent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/laudebugs/buildanagent/tree/main/packages/cli#readme",
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "buildanagent": "./dist/bin.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build && node ../../scripts/copy-licenses.mjs",
    "prepublishOnly": "node ../../scripts/refuse-local-publish.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@buildanagent/gateway": "workspace:*",
    "@buildanagent/harness": "workspace:*",
    "@buildanagent/protocol": "workspace:*",
    "@buildanagent/sdk": "workspace:*"
  }
}
