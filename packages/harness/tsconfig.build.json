{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.packages.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": [],
    "noEmit": false,
    "declaration": true,
    "inlineSources": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
