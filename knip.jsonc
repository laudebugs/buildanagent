// Unused files, exports and dependencies in packages/ (todo Q2, maintainability.md). Each package's entry points come
// from its `exports` map, which knip reads itself; the workspaces below add only what that map can't name.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export that only its own file uses is a helper that grew an `export` for no reader, not dead code, so it
  // is left to review; an export that nothing uses at all fails.
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": ["apps/*", "verify/*"],
  // The vendored anatomy skill has its own scripts and test dependencies, and is copied unchanged from upstream.
  "ignore": [".agents/**"],
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      // The tools the check:* scripts run; dependency-cruiser loads @swc/core by name, as its TypeScript 7 parser.
      "ignoreDependencies": ["@swc/core"],
      "ignoreBinaries": ["wrangler"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "test/**/*.ts"]
    },
    "packages/agent-safety": {
      // The Workers that the Cloudflare tests bundle with esbuild and run in workerd, named by path in those tests.
      // The README checks load the globals file by the path their config names.
      "entry": ["test/workerd/*-agent.ts", "scripts/readme-globals.ts"]
    },
    "packages/sdk": {
      // The README checks load this globals file by the path their config names, and the examples are run by path
      // (`pnpm exec tsx examples/01-one-call.ts`), so nothing imports them. The live run's runner is run by path from
      // scripts/live/run.mjs as well.
      "entry": ["scripts/readme-globals.ts", "examples/*.ts", "scripts/run-examples.mjs"],
      // The types TypeScript reads for examples/lib/live.mjs; knip follows the import to the .mjs file instead.
      "ignore": ["examples/lib/live.d.mts"]
    },
    "packages/protocol": {
      // The schema-check file is type-checked by `tsc` and never imported: it fails the build when the hand-written
      // types and the schemas drift apart.
      "entry": ["schema-check/*.ts", "scripts/readme-globals.ts"]
    },
    // The example is imported by its test, and the README shows it.
    "packages/cli": { "entry": ["scripts/readme-globals.ts", "examples/*.ts"] },
    // `mkfifo` makes the pipe an opt-in srt test needs, and `openssl` makes the self-signed certificate the egress proxy test
    // trusts. Node can make neither.
    // The book examples are run by path (`tsx examples/01-session-two-runs.ts`) from the shared runner, so nothing
    // imports them.
    // The AWS live run is run by path, by the owner only. The project-config tests' fixture server is started by the
    // project's own `.mcp.json`, so nothing imports it.
    "packages/harness": {
      "entry": [
        "examples/*.ts",
        "scripts/readme-globals.ts",
        "scripts/aws-live.mjs",
        "test/fixtures/mcp-project/server.mjs"
      ],
      "ignoreBinaries": ["mkfifo", "openssl"]
    }
  }
}
